generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id @default(cuid()) @db.VarChar(30)
  username     String @unique @db.VarChar(32)
  name         String @db.VarChar(80)
  passwordHash String @db.VarChar(200)
  role         String @default("player") @db.VarChar(12)
  active       Boolean @default(true)
  rating       Int @default(1000)
  games        Int @default(0)
  wins         Int @default(0)
  draws        Int @default(0)
  losses       Int @default(0)
  lastDelta    Int @default(0)
  createdAt    DateTime @default(now())
  sessions     Session[]
  entries      Entry[]
  submissions  Submission[]
  ownedEvents  Tournament[]
  @@index([rating, id])
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String @db.VarChar(30)
  expiresAt DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
}
model Tournament {
  id String @id @db.VarChar(64)
  name String @db.VarChar(80)
  description String @db.VarChar(240)
  ownerId String @db.VarChar(30)
  owner User @relation(fields:[ownerId],references:[id])
  phase String @default("registration") @db.VarChar(20)
  round Int @default(1)
  totalRounds Int @default(3)
  capacity Int @default(4000)
  mapId String @default("standard-9") @db.VarChar(32)
  firstSide String @default("white") @db.VarChar(8)
  maxTurns Int @default(31)
  moveTimeLimitMs Int @default(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries Entry[]
  matches Match[]
  submissions Submission[]
  @@index([phase, createdAt])
}
model Entry {
  tournamentId String @db.VarChar(64)
  userId String @db.VarChar(30)
  status String @default("pending") @db.VarChar(12)
  activeSubmissionId String? @db.VarChar(30)
  activeSubmission Submission? @relation("ActiveBot",fields:[activeSubmissionId],references:[id])
  tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id])
  createdAt DateTime @default(now())
  @@id([tournamentId,userId])
  @@index([tournamentId,status,userId])
}
model Submission {
  id String @id @default(cuid()) @db.VarChar(30)
  userId String @db.VarChar(30)
  tournamentId String? @db.VarChar(64)
  user User @relation(fields:[userId],references:[id])
  tournament Tournament? @relation(fields:[tournamentId],references:[id])
  filename String @db.VarChar(100)
  language String @db.VarChar(8)
  source String @db.LongText
  sourceHash String @db.Char(64)
  version Int @default(1)
  status String @default("queued") @db.VarChar(16)
  error String? @db.Text
  createdAt DateTime @default(now())
  activeEntries Entry[] @relation("ActiveBot")
  jobs Job[]
  @@index([userId,tournamentId,createdAt])
}
model Match {
  id String @id @db.VarChar(48)
  tournamentId String? @db.VarChar(64)
  tournament Tournament? @relation(fields:[tournamentId],references:[id])
  round Int @default(1)
  whiteId String @db.VarChar(30)
  blackId String? @db.VarChar(30)
  whiteSubmissionId String? @db.VarChar(30)
  blackSubmissionId String? @db.VarChar(30)
  ownerId String? @db.VarChar(30)
  status String @default("queued") @db.VarChar(16)
  config Json
  runId String? @db.VarChar(36)
  whiteBefore Int @default(1000)
  blackBefore Int @default(1000)
  whiteDelta Int @default(0)
  blackDelta Int @default(0)
  score Float?
  result Json?
  metadata Json?
  snapshot Json?
  error String? @db.Text
  rated Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  frames Frame[]
  jobs Job[]
  @@unique([tournamentId,round,whiteId])
  @@index([tournamentId,round,status])
  @@index([status,createdAt])
  @@index([ownerId,createdAt])
}
model Frame {
  matchId String @db.VarChar(48)
  runId String @db.VarChar(36)
  seq Int
  payload Json
  match Match @relation(fields:[matchId],references:[id],onDelete:Cascade)
  @@id([matchId,runId,seq])
}
model Job {
  id String @id @default(cuid()) @db.VarChar(30)
  key String @unique @db.VarChar(100)
  type String @db.VarChar(12)
  status String @default("queued") @db.VarChar(12)
  submissionId String? @db.VarChar(30)
  submission Submission? @relation(fields:[submissionId],references:[id])
  matchId String? @db.VarChar(48)
  match Match? @relation(fields:[matchId],references:[id])
  config Json?
  attempts Int @default(0)
  claim String? @db.VarChar(36)
  leaseUntil DateTime?
  availableAt DateTime @default(now())
  error String? @db.Text
  createdAt DateTime @default(now())
  @@index([status,availableAt,createdAt])
  @@index([status,leaseUntil])
}
model RateBucket {
  key String @id @db.VarChar(100)
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
model Audit {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId String? @db.VarChar(30)
  action String @db.VarChar(48)
  tournamentId String? @db.VarChar(64)
  metadata Json?
  createdAt DateTime @default(now())
  @@index([tournamentId,createdAt])
}
