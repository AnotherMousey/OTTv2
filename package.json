{
  "name": "ottv2-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run samples && npm --prefix frontend ci && npm --prefix frontend run build && node scripts/build-preview.mjs",
    "start": "node logic/main.js",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.mjs && npm --prefix frontend test",
    "demo:room": "node scripts/demo-room.mjs",
    "samples": "node scripts/generate-samples.cjs",
    "test:bots": "node --test tests/bot-runners.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
