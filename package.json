{
  "name": "ottv2-tournament-platform",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node services/api/index.cjs",
    "worker": "node services/worker/index.cjs",
    "runner": "node services/runner/index.cjs",
    "dev": "node --watch services/api/index.cjs",
    "build": "prisma generate && npm --prefix frontend ci && npm --prefix frontend run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "node scripts/migrate.cjs",
    "db:bootstrap": "node services/api/bootstrap.cjs",
    "db:import": "node services/api/import-json.cjs",
    "test": "node --test services/tests/*.test.cjs && npm --prefix frontend test",
    "test:db": "node --test services/tests/database.integration.cjs",
    "db:accounts": "node services/api/accounts.cjs",
    "worker:docker": "node scripts/start-railway-worker.cjs",
    "queue:check": "node scripts/check-queue.cjs",
    "offline:prepare": "node scripts/prepare-offline.cjs",
    "offline": "node scripts/offline.cjs",
    "sync": "node scripts/tournament-sync.cjs",
    "benchmark:pairing": "node scripts/benchmark-pairing.cjs",
    "test:sync:db": "node --test services/tests/sync.integration.cjs",
    "deployment:check": "node scripts/check-deployment.cjs",
    "db:status": "prisma migrate status",
    "test:deployment:db": "node --test services/tests/schema-drift.integration.cjs",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "prisma": "6.19.0",
    "express": "5.1.0"
  }
}
