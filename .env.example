# Local commands can use: node --env-file=.env services/api/index.cjs
# Render: configure environment variables in service settings instead.
DATABASE_URL=mysql://ott_app:REPLACE_ME@RAILWAY_PUBLIC_HOST:PORT/railway?connection_limit=5&pool_timeout=10&connect_timeout=10
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3000
OPERATOR_USERNAME=tournament-judge
OPERATOR_NAME=Tournament Judge
OPERATOR_PASSWORD=REPLACE_WITH_12_OR_MORE_CHARACTERS
RUNNER_URL=https://YOUR_ISOLATED_RUNNER_HOST
RUNNER_SECRET=REPLACE_WITH_A_RANDOM_32_OR_MORE_CHARACTER_SECRET
WORKER_CONCURRENCY=2
# Required only for compose.local.yaml; use URL-safe random values.
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX

# Render API pre-deploy only; migrations need DDL privileges.
MIGRATION_DATABASE_URL=mysql://MIGRATION_USER:REPLACE_ME@RAILWAY_PUBLIC_HOST:PORT/railway?connection_limit=2
